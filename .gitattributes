# Normalize text files to LF in the repo; scripts and container files must stay LF on checkout
* text=auto eol=lf

mvnw text eol=lf
*.sh text eol=lf
*.template text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

*.jar binary
*.ttf binary
*.png binary
*.jpg binary
*.webp binary
