# Kuratoon configuration. Copy to deploy/.env and fill in the required values:
#   cp deploy/.env.example deploy/.env
# Spec: docs/spec/08-deployment.md. Never commit deploy/.env.
#
# Before the first start, create the host folders below and make them owned by PUID:PGID, e.g.:
#   mkdir -p data/import data/library data/data data/plugins data/postgres
#   sudo chown -R 1000:1000 data && sudo chmod -R u=rwX,g=rX,o= data
# The backend writes files 0640 / dirs 0750; nginx reads them through the PGID group.
# Relative paths are resolved from the deploy/ folder.

# ---- Network -----------------------------------------------------------------------------------
# The only published port (internal nginx). Put your own reverse proxy / TLS in front of it.
APP_PORT=8080
# Required. Public URL of the app, used in emails and absolute links. This is the ONLY supported
# access URL: browsers must use exactly this origin (scheme, host, port), because state-changing
# requests from any other origin are rejected (CSRF protection), and the auth cookies are marked
# Secure only when it is https. To use the app from several addresses (LAN IP, Tailscale name),
# pick one of them here.
APP_BASE_URL=http://localhost:8080
# Comma-separated IPs/CIDRs of your reverse proxy, so client IPs come from X-Forwarded-For.
# Leave empty if nothing sits in front of APP_PORT. Only nginx uses this.
TRUSTED_PROXIES=
# Subnet of the internal compose network. The backend accepts X-Forwarded-For only from it.
# Change only if it collides with an existing network on the host.
INTERNAL_SUBNET=172.30.71.0/24

# ---- File ownership ----------------------------------------------------------------------------
PUID=1000
PGID=1000

# ---- Host paths (required) ---------------------------------------------------------------------
# Drop folders to import here (may be on a different disk than the library).
IMPORT_DIR=./data/import
# The managed library (chapters, sidecars).
LIBRARY_DIR=./data/library
# Generated data (thumbnails, moments).
DATA_DIR=./data/data
# Metadata plugin JARs (read-only for the app). Only install plugins you trust.
PLUGINS_DIR=./data/plugins
# Root for service state; Postgres stores its data in ${DATA_ROOT}/postgres.
DATA_ROOT=./data

# ---- Database ----------------------------------------------------------------------------------
POSTGRES_DB=kuratoon
POSTGRES_USER=kuratoon
# Required. Generate one, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---- Security ----------------------------------------------------------------------------------
# Required, at least 32 bytes. Signs access tokens. Generate: openssl rand -base64 48
JWT_SECRET=
# signed (default) | public. "public" serves images without signatures (LAN/VPN-only installs).
IMAGE_ACCESS=signed
# Required when IMAGE_ACCESS=signed. Shared with nginx secure_link. Generate: openssl rand -base64 32
IMAGE_SIGNING_SECRET=

# ---- Admin bootstrap (optional) ----------------------------------------------------------------
# If set, this admin is created on first boot (otherwise the first-run setup page is used).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# true resets that admin's password/role on boot. Remove (set false) after use.
ADMIN_FORCE_RESET=false

# ---- Email (optional, enables password reset) --------------------------------------------------
# Leave SMTP_HOST empty to disable mail (admins then reset passwords on the Users page).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Required when SMTP_HOST is set.
SMTP_FROM=
# true: STARTTLS required (typically port 587); false: plain connection.
# Implicit TLS (SMTPS, port 465) is not supported.
SMTP_TLS=false

# ---- Metadata fetching -------------------------------------------------------------------------
# FlareSolverr-compatible solver endpoint. Empty disables it (also comment out byparr in compose).
SOLVER_URL=http://byparr:8191
SOLVER_TIMEOUT_MS=60000
# Language used when metadata has none.
DEFAULT_LANGUAGE=en

# ---- Imports -----------------------------------------------------------------------------------
IMPORT_POLL_SECONDS=30
IMPORT_STABLE_SECONDS=60

# ---- Rate limits (nginx) -----------------------------------------------------------------------
# AUTH applies to /api/v1/auth/* (per IP, requests per minute). IMAGES and API apply from phase 5.
RATE_LIMIT_IMAGES_RPS=40
RATE_LIMIT_IMAGES_BURST=200
RATE_LIMIT_API_RPS=20
RATE_LIMIT_API_BURST=60
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_AUTH_BURST=10

# ---- Logging -----------------------------------------------------------------------------------
LOG_LEVEL=INFO
