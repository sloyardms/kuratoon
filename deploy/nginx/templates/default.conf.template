# Internal nginx: the only published service. Rendered with envsubst at container start
# (official image templates mechanism). Real-IP settings come from 15-real-ip.sh.
# Image delivery (/img/, secure_link) and the image/API rate limits are added in phase 5.

server_tokens off;

# Keep the scheme set by the installer's TLS proxy; fall back to the connection scheme.
map $http_x_forwarded_proto $kuratoon_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_vary on;
gzip_types text/plain text/css text/javascript application/javascript application/json
           application/problem+json image/svg+xml;

# Coarse per-IP limit on the auth endpoints (docs/spec/04-auth-users.md); the backend applies the
# finer per-IP and per-username limits behind it.
limit_req_zone $binary_remote_addr zone=kuratoon_auth:10m rate=${RATE_LIMIT_AUTH_RPM}r/m;
limit_req_status 429;

upstream kuratoon_frontend {
    server frontend:3000;
    keepalive 16;
}

upstream kuratoon_backend {
    server backend:8080;
    keepalive 16;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    client_max_body_size 1m;

    # Security headers. The CSP is deliberately permissive in phase 0 and is tightened once the
    # real pages exist. No HSTS: TLS is terminated by the installer's own proxy.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Overwrite, never append: $remote_addr is already the real client (real_ip module, trusted
    # proxies only), so anything a client sends in X-Forwarded-For is dropped here.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $kuratoon_forwarded_proto;
    proxy_set_header X-Forwarded-Host $host;

    # Liveness of nginx itself (compose healthcheck). Reveals nothing, so it is not restricted:
    # behind Docker's port proxy, client addresses are not reliable enough for allow/deny.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Read-only and requested by every auth page, so it is not counted against the auth limit.
    location = /api/v1/auth/status {
        proxy_pass http://kuratoon_backend;
    }

    location /api/v1/auth/ {
        limit_req zone=kuratoon_auth burst=${RATE_LIMIT_AUTH_BURST} nodelay;
        error_page 429 = @too_many_requests;
        proxy_pass http://kuratoon_backend;
    }

    location @too_many_requests {
        default_type application/problem+json;
        add_header Retry-After 60 always;
        return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"Too many attempts. Try again later."}';
    }

    location /api/ {
        proxy_pass http://kuratoon_backend;
    }

    location / {
        proxy_pass http://kuratoon_frontend;
    }
}
